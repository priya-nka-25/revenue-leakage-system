# MongoDB Configuration
# ====================

# MongoDB Connection URI
# Default: Local MongoDB instance
MONGO_URI=mongodb://localhost:27017/

# Alternative connection strings:
# MONGO_URI=mongodb://username:password@localhost:27017/
# MONGO_URI=mongodb://username:password@cluster.mongodb.net/
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/

# Database Name
# The database where all collections will be created
DB_NAME=revenue_leakage_system

# Flask Configuration
# ==================

# Flask Environment
# Options: development, production, testing
FLASK_ENV=development

# Flask Debug Mode
# Enable/disable debug mode
FLASK_DEBUG=true

# Flask Secret Key
# Used for session management and security
# Generate a strong secret key for production
SECRET_KEY=your-super-secret-key-change-this-in-production

# Server Configuration
# ===================

# Host Binding
# 0.0.0.0 allows external connections, 127.0.0.1 for local only
HOST=0.0.0.0

# Port Number
# The port where the Flask server will run
PORT=5000

# MongoDB Advanced Configuration
# =============================

# MongoDB Connection Pool Size
# Number of connections in the connection pool
MONGO_MAX_POOL_SIZE=100

# MongoDB Connection Timeout
# Connection timeout in milliseconds
MONGO_CONNECT_TIMEOUT_MS=20000

# MongoDB Server Selection Timeout
# Server selection timeout in milliseconds
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# MongoDB Socket Timeout
# Socket timeout in milliseconds
MONGO_SOCKET_TIMEOUT_MS=20000

# Security Configuration
# =====================

# CORS Origins
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
# Enable/disable rate limiting
ENABLE_RATE_LIMITING=false

# Rate Limit Requests per Minute
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Logging Configuration
# ====================

# Log Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log File Path
# Path to log file (optional)
LOG_FILE=logs/app.log

# AI Processing Configuration
# ==========================

# AI Processing Timeout
# Maximum time for AI processing in seconds
AI_PROCESSING_TIMEOUT=300

# Enable AI Processing
# Enable/disable AI processing simulation
ENABLE_AI_PROCESSING=true

# Development/Testing Configuration
# ===============================

# Mock Data
# Enable/disable mock data generation
ENABLE_MOCK_DATA=false

# Test Mode
# Enable/disable test mode features
TEST_MODE=false

# Database Seeding
# Enable/disable automatic database seeding
ENABLE_DB_SEEDING=true

# Example Production Configuration
# ===============================
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/
# DB_NAME=revenue_leakage_prod
# FLASK_ENV=production
# FLASK_DEBUG=false
# SECRET_KEY=your-production-secret-key-here
# HOST=0.0.0.0
# PORT=5000
# LOG_LEVEL=WARNING
# ENABLE_RATE_LIMITING=true
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
